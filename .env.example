# Solana JSON-RPC endpoint (reads, simulation and sending)
RPC_URL=https://api.mainnet-beta.solana.com
# ALT authority + fee payer: path to a solana-keygen JSON keypair file (preferred) ...
KEYPAIR_PATH=~/.config/solana/id.json
# ... or the secret key itself (JSON byte array or base58). NEVER commit a real value.
PRIVATE_KEY=
